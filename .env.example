# Copie ce fichier en .env et remplis les valeurs.
# Ne commite jamais .env (il est dans .gitignore).

# --- order-service (PostgreSQL) ---
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5432
ORDER_DB_NAME=orders
ORDER_DB_USER=postgres
ORDER_DB_PASSWORD=postgres

# --- optionnel : URLs des services (défauts en local) ---
# PRODUCT_SERVICE_URL=http://localhost:3005
# ORDER_SERVICE_URL=http://localhost:3006
